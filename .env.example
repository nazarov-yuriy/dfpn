# Clients that send this key (Authorization: Bearer <key>) are served entirely on the operator's keys.
# Any other key is forwarded to Tavily as the client's own key (BYOK); reranking/enrichment still use OPENAI_API_KEY.
SERVICE_API_KEY=change-me
# The operator's Tavily key (used for requests made with SERVICE_API_KEY).
TAVILY_API_KEY=tvly-...
# The operator's OpenAI key (Decisions API reranking and detection, Responses API rephrasing) for every request.
OPENAI_API_KEY=sk-...
# Optional
# RERANK_CONTENT_CHARS=4000        # characters of each document the reranker sees (the benchmark entries used 600)
# RERANK_PREFER_REFERENCE=false    # ask the reranker to prefer Wikipedia / authoritative sources (did not help on SimpleQA)
# ENRICH_CACHE=true                # cache detection / rephrasing LLM calls with the Tavily cache's TTL
# TAVILY_CACHE_DIR=cache           # persistent Tavily response cache (/data/cache in the Docker image)
# TAVILY_CACHE_TTL_S=604800        # cache time-to-live (7 days); 0 disables the cache
# EXCLUDE_DOMAINS=facebook.com,instagram.com,youtube.com,reddit.com,tiktok.com,x.com,twitter.com,linkedin.com,pinterest.com,quora.com,threads.net
#                                  # domains harder searches both with and without, marking their pages for the
#                                  # reranker; empty = every call once, nothing marked
# TAVILY_ARCHIVE_DB=/data/archive.sqlite  # durable archive of every cached response (default: next to the cache dir; empty = off)
# OPENAI_MODEL=gpt-6-luna
# REPHRASE_EFFORT=low
# UPSTREAM_TIMEOUT_S=60
# KEY_CACHE_TTL_S=600
# INVALID_KEY_TTL_S=60
# LOG_LEVEL=INFO
